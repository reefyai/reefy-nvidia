#!/bin/sh
set -eu

IFS=:
set -- ${REEFY_ARTIFACT_MOUNTS:?}
unset IFS
COMMON=${1:?missing common NVIDIA layer}
KERNEL_LAYER=${2:?missing NVIDIA kernel layer}
KERNEL_RELEASE=$(uname -r)
MODULE_SOURCE="$KERNEL_LAYER/lib/modules/$KERNEL_RELEASE/extra/nvidia"
FIRMWARE_SOURCE="$COMMON/lib/firmware/nvidia"
DRIVER_ROOT=/run/reefy-artifacts/providers/nvidia-driver

[ -d "$MODULE_SOURCE" ]
[ -d "$FIRMWARE_SOURCE" ]
[ -d "$COMMON/usr/lib" ]
[ -x "$COMMON/usr/bin/nvidia-smi" ]
[ -x "$COMMON/usr/bin/nvidia-ctk" ]

bind_read_only() {
    source=$1
    target=$2
    mkdir -p "$target"
    if ! mountpoint -q "$target"; then
        mount --bind "$source" "$target"
        mount -o remount,bind,ro,nodev,nosuid "$source" "$target"
    fi
}

bind_read_only "$MODULE_SOURCE" \
    "/lib/modules/$KERNEL_RELEASE/extra/nvidia"
bind_read_only "$FIRMWARE_SOURCE" "/lib/firmware/nvidia"

# Present the payload in NVIDIA Container Toolkit's standard driver-root
# layout. CDI maps libraries into normal container loader paths while every
# source byte remains in the read-only OCI payload.
mkdir -p "$DRIVER_ROOT/usr/lib/x86_64-linux-gnu" \
    "$DRIVER_ROOT/usr/bin" \
    "$DRIVER_ROOT/etc/vulkan/icd.d" \
    "$DRIVER_ROOT/etc/glvnd/egl_vendor.d" \
    "$DRIVER_ROOT/usr/share/vulkan/implicit_layer.d" \
    "$DRIVER_ROOT/usr/share/egl/egl_external_platform.d" \
    "$DRIVER_ROOT/usr/share/nvidia" \
    "$DRIVER_ROOT/lib/firmware/nvidia"
bind_read_only "$COMMON/usr/lib" \
    "$DRIVER_ROOT/usr/lib/x86_64-linux-gnu"
bind_read_only "$COMMON/usr/bin" "$DRIVER_ROOT/usr/bin"
bind_read_only "$COMMON/usr/share/vulkan/icd.d" \
    "$DRIVER_ROOT/etc/vulkan/icd.d"
bind_read_only "$COMMON/usr/share/glvnd/egl_vendor.d" \
    "$DRIVER_ROOT/etc/glvnd/egl_vendor.d"
bind_read_only "$COMMON/usr/share/vulkan/implicit_layer.d" \
    "$DRIVER_ROOT/usr/share/vulkan/implicit_layer.d"
bind_read_only "$COMMON/usr/share/egl/egl_external_platform.d" \
    "$DRIVER_ROOT/usr/share/egl/egl_external_platform.d"
bind_read_only "$COMMON/usr/share/nvidia" \
    "$DRIVER_ROOT/usr/share/nvidia"
bind_read_only "$FIRMWARE_SOURCE" "$DRIVER_ROOT/lib/firmware/nvidia"

mkdir -p /usr/lib /usr/bin /etc/vulkan/icd.d \
    /etc/glvnd/egl_vendor.d /run/cdi
rm -f /run/cdi/nvidia.tmp.yaml /run/cdi/nvidia.yaml \
    /etc/cdi/nvidia.yaml

# Reefy intentionally does not ship ldconfig. Ephemeral links in OverlayFS
# expose the version-matched provider libraries without copying their bytes.
for library in "$COMMON"/usr/lib/*.so*; do
    [ -e "$library" ] || continue
    ln -sfn "$library" "/usr/lib/${library##*/}"
done

for binary in nvidia-smi nvidia-ctk nvidia-cdi-hook; do
    if [ -x "$COMMON/usr/bin/$binary" ]; then
        ln -sfn "$COMMON/usr/bin/$binary" "/usr/bin/$binary"
    fi
done
if [ -f "$COMMON/usr/share/vulkan/icd.d/nvidia_icd.json" ]; then
    ln -sfn "$COMMON/usr/share/vulkan/icd.d/nvidia_icd.json" \
        /etc/vulkan/icd.d/nvidia_icd.json
fi
if [ -f "$COMMON/usr/share/glvnd/egl_vendor.d/10_nvidia.json" ]; then
    ln -sfn "$COMMON/usr/share/glvnd/egl_vendor.d/10_nvidia.json" \
        /etc/glvnd/egl_vendor.d/10_nvidia.json
fi

depmod "$KERNEL_RELEASE"
modprobe nvidia
modprobe nvidia-uvm
modprobe nvidia-modeset
modprobe nvidia-drm

# Let the NVIDIA driver determine whether it supports a GPU on this system.
# Reefy and the provider hook do not maintain a PCI product-ID table.
GPU_INDEX=0
for gpu_dir in /proc/driver/nvidia/gpus/*/; do
    [ -d "$gpu_dir" ] || continue
    GPU_INDEX=$((GPU_INDEX + 1))
done
if [ "$GPU_INDEX" -eq 0 ]; then
    echo "NVIDIA driver found no usable GPUs; activation is a no-op"
    exit 0
fi

# NVIDIA's out-of-tree modules do not always get device nodes from devtmpfs
# on this minimal host.
NVIDIA_MAJOR=$(awk '/^[0-9]+ nvidiactl$/{print $1}' /proc/devices)
[ -n "$NVIDIA_MAJOR" ]
[ -e /dev/nvidiactl ] || mknod -m 666 /dev/nvidiactl c "$NVIDIA_MAJOR" 255
[ -e /dev/nvidia-modeset ] || \
    mknod -m 666 /dev/nvidia-modeset c "$NVIDIA_MAJOR" 254
GPU_INDEX=0
for gpu_dir in /proc/driver/nvidia/gpus/*/; do
    [ -d "$gpu_dir" ] || continue
    [ -e "/dev/nvidia$GPU_INDEX" ] || \
        mknod -m 666 "/dev/nvidia$GPU_INDEX" c "$NVIDIA_MAJOR" "$GPU_INDEX"
    GPU_INDEX=$((GPU_INDEX + 1))
done
NVIDIA_UVM_MAJOR=$(awk '/^[0-9]+ nvidia-uvm$/{print $1}' /proc/devices || true)
if [ -n "$NVIDIA_UVM_MAJOR" ]; then
    [ -e /dev/nvidia-uvm ] || \
        mknod -m 666 /dev/nvidia-uvm c "$NVIDIA_UVM_MAJOR" 0
    [ -e /dev/nvidia-uvm-tools ] || \
        mknod -m 666 /dev/nvidia-uvm-tools c "$NVIDIA_UVM_MAJOR" 1
fi

nvidia-smi >/dev/null

# Publish CDI only after module, device, and userspace initialization succeeds.
temporary=/run/cdi/nvidia.tmp.yaml
trap 'rm -f "$temporary"' EXIT
nvidia-ctk cdi generate --disable-hook update-ldcache \
    --driver-root="$DRIVER_ROOT" --dev-root=/ \
    --output="$temporary"
mv -f "$temporary" /run/cdi/nvidia.yaml
trap - EXIT
echo "NVIDIA provider activated and CDI published"
